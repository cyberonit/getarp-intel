[Unit]
StartLimitIntervalSec=0
Description=getarp shipper (sensor logs to the core over HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
# Only this account may reach the core's ingest (see the sensor firewall).
User=getarp-ship
Group=getarp-ship
SupplementaryGroups=getarp-logs
# GETARP_CORE_URL and GETARP_SENSOR_KEY (readable by root and this account only)
EnvironmentFile=/etc/getarp/shipper.env
StateDirectory=getarp-shipper
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -I /opt/getarp/sensor/getarp-shipper.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
