[Unit]
Description=getarp firewall (nftables table "inet getarp")
Documentation=file:///opt/getarp/docs/USER_GUIDE.md
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The file is written by getarp-ctl (edit the registry, then "getarp-ctl apply").
# It replaces only getarp's own table; CrowdSec's tables are left alone.
# There is deliberately no ExecStop: stopping this unit leaves the rules in place.
ExecStart=/usr/sbin/nft -f /etc/getarp/nftables.nft
ExecReload=/usr/sbin/nft -f /etc/getarp/nftables.nft

[Install]
WantedBy=multi-user.target
