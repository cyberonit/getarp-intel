#!/usr/bin/env bash
# getarp-ctl — day-to-day operations for a getarp core or sensor.
#
# On the core:
#   getarp-ctl status                                  services, tunnel and sensors at a glance
#   getarp-ctl info                                    what a new sensor or admin laptop needs to connect
#   getarp-ctl sensor add <name> <tunnel-ip> <public-key> <public-ip>
#   getarp-ctl sensor remove <name>                    revoke now; its address is never reused
#   getarp-ctl admin add <name> <tunnel-ip> <public-key>   prints the laptop's tunnel config
#   getarp-ctl admin remove <name>
#   getarp-ctl list                                    every registered peer
#   getarp-ctl apply                                   rebuild tunnel, firewall and allowlist from the registry
#   getarp-ctl backup                                  database dump now (also runs daily)
#   getarp-ctl password <username>                     set a dashboard login's password (creates it if new)
#
# On a sensor:
#   getarp-ctl status | info | apply
#
# Addresses: core 10.66.0.1 · admin laptops 10.66.0.2–10 · sensors 10.66.0.11–250
# shellcheck disable=SC2015
set -euo pipefail

ETC=${GETARP_ETC:-/etc/getarp}
WG_DIR=${GETARP_WG_DIR:-/etc/wireguard}
LIB=${GETARP_LIB:-/var/lib/getarp}
PEERS="$ETC/peers.csv"
PEERS_HEADER="kind,name,tunnel_ip,pubkey,public_ip,enabled"
NFT_FILE="$ETC/nftables.nft"
DRY_RUN=${GETARP_DRY_RUN:-0}   # 1 = render files only, touch no live service (tests)

die() { echo "getarp-ctl: $*" >&2; exit 1; }
say() { echo "[getarp] $*"; }
live() { [ "$DRY_RUN" != 1 ]; }

role() {
  [ -f "$ETC/role" ] || die "this machine is not set up yet (no $ETC/role); run install.sh first"
  cat "$ETC/role"
}

need_root() { live || return 0; [ "$(id -u)" = 0 ] || die "run as root (sudo)"; }

load_env() {
  # shellcheck disable=SC1090
  . "$ETC/$1.env"
}

# ---------------------------------------------------------------- validation
ip_last_octet() { # prints N for 10.66.0.N, or fails
  [[ "$1" =~ ^10\.66\.0\.([0-9]{1,3})$ ]] || return 1
  local n=${BASH_REMATCH[1]}
  [ "$n" -ge 0 ] && [ "$n" -le 255 ] || return 1
  echo "$n"
}
valid_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{1,30}$ ]]; }
valid_key() { [[ "$1" =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]]; }
valid_ipv4() {
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o; for o in "${BASH_REMATCH[@]:1}"; do [ "$o" -le 255 ] || return 1; done
}

# ---------------------------------------------------------------- registry
ensure_registry() { [ -f "$PEERS" ] || { echo "$PEERS_HEADER" > "$PEERS"; chmod 0644 "$PEERS"; }; }

peers_rows() { tail -n +2 "$PEERS"; }  # kind,name,tunnel_ip,pubkey,public_ip,enabled

enabled_rows() { peers_rows | awk -F, -v k="$1" '$1==k && $6=="yes"'; }

registry_add() { # kind name tunnel_ip pubkey public_ip
  local kind=$1 name=$2 ip=$3 key=$4 pub=${5:-}
  valid_name "$name" || die "name must be lowercase letters, digits and dashes, e.g. s01"
  valid_key "$key" || die "that is not a WireGuard public key (44 characters ending in =)"
  local n; n=$(ip_last_octet "$ip") || die "tunnel address must be 10.66.0.N"
  if [ "$kind" = sensor ]; then
    { [ "$n" -ge 11 ] && [ "$n" -le 250 ]; } || die "sensor addresses are 10.66.0.11 to 10.66.0.250"
    valid_ipv4 "$pub" || die "give the sensor's public IPv4 address"
  else
    { [ "$n" -ge 2 ] && [ "$n" -le 10 ]; } || die "admin addresses are 10.66.0.2 to 10.66.0.10"
  fi
  ensure_registry
  # Names and addresses are never reused, not even after removal.
  if peers_rows | awk -F, -v n="$name" '$2==n{f=1} END{exit !f}'; then
    die "the name $name is (or was) registered; pick a new one"
  fi
  if peers_rows | awk -F, -v a="$ip" '$3==a{f=1} END{exit !f}'; then
    die "$ip is (or was) used by another peer; pick a new address"
  fi
  if peers_rows | awk -F, -v k="$key" '$4==k{f=1} END{exit !f}'; then
    die "that public key is already registered"
  fi
  echo "$kind,$name,$ip,$key,$pub,yes" >> "$PEERS"
}

registry_disable() { # kind name
  ensure_registry
  peers_rows | awk -F, -v k="$1" -v n="$2" '$1==k && $2==n && $6=="yes"{f=1} END{exit !f}' \
    || die "no active $1 called $2"
  local tmp; tmp=$(mktemp "$ETC/peers.XXXXXX")
  awk -F, -v OFS=, -v k="$1" -v n="$2" 'NR>1 && $1==k && $2==n {$6="no"} {print}' "$PEERS" > "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$PEERS"
}

# ---------------------------------------------------------------- core: render
render_wg_core() {
  load_env core
  local tmp; tmp=$(mktemp "$WG_DIR/wg0.conf.XXXXXX")
  {
    echo "# Written by getarp-ctl from $PEERS. Do not edit by hand."
    echo "[Interface]"
    echo "Address = 10.66.0.1/24"
    echo "ListenPort = ${WG_PORT:-51820}"
    echo "PrivateKey = $(cat "$WG_DIR/private.key")"
    local kind name ip key pub en
    while IFS=, read -r kind name ip key pub en; do
      [ "$en" = yes ] || continue
      echo
      echo "# $kind $name${pub:+ ($pub)}"
      echo "[Peer]"
      echo "PublicKey = $key"
      echo "AllowedIPs = $ip/32"
    done < <(peers_rows)
  } > "$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$WG_DIR/wg0.conf"
  if live && ip link show wg0 >/dev/null 2>&1; then
    wg syncconf wg0 <(wg-quick strip wg0)
  fi
}

render_nft_core() {
  load_env core
  local sensors; sensors=$(enabled_rows sensor | cut -d, -f3 | paste -sd, - | sed 's/,/, /g')
  local tmp; tmp=$(mktemp "$ETC/nftables.XXXXXX")
  cat > "$tmp" <<EOF
#!/usr/sbin/nft -f
# getarp core firewall. Written by getarp-ctl; edit the registry, not this file.
# Lives in its own table: never touches CrowdSec's tables or anything else.

table inet getarp
delete table inet getarp

table inet getarp {
	# registered, enabled sensors (tunnel addresses)
	set sensors {
		type ipv4_addr
$( [ -n "$sensors" ] && printf '\t\telements = { %s }\n' "$sensors" )
	}

	set admins {
		type ipv4_addr
		flags interval
		elements = { 10.66.0.2-10.66.0.10 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept
		meta l4proto icmp accept

		# tunnel addresses only ever arrive through the tunnel
		iifname != "wg0" ip daddr 10.66.0.0/24 drop

		# public: the dashboard, the tunnel, admin SSH
		iifname != "wg0" tcp dport { 80, 443 } accept
		udp dport ${WG_PORT:-51820} accept
		iifname != "wg0" tcp dport { ${SSH_PORTS} } accept

		# tunnel: sensors may only push logs; admins may reach the admin site
		iifname "wg0" ip saddr @sensors ip daddr 10.66.0.1 tcp dport 6000 accept
		iifname "wg0" ip saddr @admins ip daddr 10.66.0.1 tcp dport 443 accept

		limit rate 10/minute log prefix "getarp-in-drop " level info
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		# admin laptops may SSH to a sensor through the core; nothing else crosses
		iifname "wg0" oifname "wg0" ip saddr @admins ip daddr @sensors tcp dport 2022 accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
		# the core never opens a connection to a sensor
		oifname "wg0" ip daddr 10.66.0.11-10.66.0.250 ct state new drop
	}
}
EOF
  chmod 0600 "$tmp"
  if live; then
    nft -c -f "$tmp" || { rm -f "$tmp"; die "new firewall rules failed the syntax check; nothing changed"; }
  fi
  mv "$tmp" "$NFT_FILE"
  if live; then nft -f "$NFT_FILE"; fi
}

render_crowdsec_allowlist() {
  load_env core
  local dir=${GETARP_CROWDSEC_DIR:-/etc/crowdsec}/parsers/s02-enrich
  [ -d "$dir" ] || { live && return 0; mkdir -p "$dir"; }
  local tmp; tmp=$(mktemp "$dir/.getarp-whitelist.XXXXXX")
  {
    echo "# Written by getarp-ctl. getarp's own addresses are never banned."
    echo "name: getarp/whitelist"
    echo "description: getarp infrastructure"
    echo "whitelist:"
    echo "  reason: getarp infrastructure"
    echo "  ip:"
    echo "    - \"127.0.0.1\""
    [ -n "${PUBLIC_IP:-}" ] && echo "    - \"$PUBLIC_IP\""
    [ -n "${BIND_IP:-}" ] && echo "    - \"$BIND_IP\""
    enabled_rows sensor | cut -d, -f5 | awk 'NF{print "    - \"" $0 "\""}'
    echo "  cidr:"
    echo "    - \"10.66.0.0/24\""
  } > "$tmp"
  chmod 0644 "$tmp"
  if cmp -s "$tmp" "$dir/getarp-whitelist.yaml"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$dir/getarp-whitelist.yaml"
    if live && systemctl is-active --quiet crowdsec; then systemctl reload crowdsec || systemctl restart crowdsec; fi
  fi
}

# ---------------------------------------------------------------- sensor: render
render_nft_sensor() {
  load_env sensor
  # Accounts allowed to reach the internet for updates, DNS and time. The decoy
  # accounts (cowrie, hpextra) and suricata are deliberately absent.
  local u users=()
  for u in root _apt systemd-resolve systemd-timesync _chrony; do
    getent passwd "$u" >/dev/null && users+=("\"$u\"")
  done
  local userset; userset=$(IFS=,; echo "${users[*]}" | sed 's/,/, /g')
  local admin_rule=""
  if [ -n "${ADMIN_CIDR:-}" ]; then
    admin_rule="iifname \"${PUBLIC_IFACE}\" ip saddr ${ADMIN_CIDR} tcp dport 2022 accept"
  fi
  local tmp; tmp=$(mktemp "$ETC/nftables.XXXXXX")
  cat > "$tmp" <<EOF
#!/usr/sbin/nft -f
# getarp sensor firewall. Written by getarp-ctl.
# Default deny both ways. The decoys answer attackers; only the shipper may
# send anything to the core; the decoy accounts cannot open any connection.

table inet getarp
delete table inet getarp

table inet getarp {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		# public decoy ports -> unprivileged decoy listeners
		iifname "${PUBLIC_IFACE}" tcp dport 22 redirect to :2222
		iifname "${PUBLIC_IFACE}" tcp dport 23 redirect to :2223
		iifname "${PUBLIC_IFACE}" tcp dport 80 redirect to :8080
		iifname "${PUBLIC_IFACE}" tcp dport 21 redirect to :2121
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept
		meta l4proto icmp accept

		# decoys
		iifname "${PUBLIC_IFACE}" tcp dport { 2222, 2223, 8080, 8081, 2121, 3306, 6379 } accept

		# the tunnel to the core
		ip saddr ${CORE_IP} udp sport ${WG_PORT:-51820} accept

		# admin SSH: through the tunnel, plus the installing address if one was given
		iifname "wg0" ip saddr 10.66.0.2-10.66.0.10 tcp dport 2022 accept
		${admin_rule}
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy drop;
		ct state established,related accept
		oifname "lo" accept

		ip daddr ${CORE_IP} udp dport ${WG_PORT:-51820} accept
		oifname "wg0" ip daddr 10.66.0.1 tcp dport 6000 meta skuid "getarp-ship" accept

		# updates, names and time for the system accounts only
		meta skuid { ${userset} } udp dport { 53, 123 } accept
		meta skuid { ${userset} } tcp dport { 53, 80, 443 } accept

		limit rate 10/minute log prefix "getarp-out-drop " level warn
	}
}
EOF
  chmod 0600 "$tmp"
  if live; then
    nft -c -f "$tmp" || { rm -f "$tmp"; die "new firewall rules failed the syntax check; nothing changed"; }
  fi
  mv "$tmp" "$NFT_FILE"
  if live; then nft -f "$NFT_FILE"; fi
}

# ---------------------------------------------------------------- commands
cmd_apply() {
  need_root
  case $(role) in
    core) ensure_registry; render_wg_core; render_nft_core; render_crowdsec_allowlist ;;
    sensor) render_nft_sensor ;;
  esac
  say "applied"
}

cmd_sensor() {
  need_root
  [ "$(role)" = core ] || die "sensors are managed on the core"
  case ${1:-} in
    add)
      [ $# -eq 5 ] || die "usage: getarp-ctl sensor add <name> <tunnel-ip> <public-key> <public-ip>"
      registry_add sensor "$2" "$3" "$4" "$5"
      cmd_apply >/dev/null
      say "sensor $2 added at $3. On the sensor, 'getarp-ctl status' should show a handshake within a minute."
      ;;
    remove)
      [ $# -eq 2 ] || die "usage: getarp-ctl sensor remove <name>"
      registry_disable sensor "$2"
      cmd_apply >/dev/null
      say "sensor $2 revoked: its tunnel key is gone and the ingest refuses it. Collected data is kept."
      ;;
    *) die "usage: getarp-ctl sensor add|remove ..." ;;
  esac
}

cmd_admin() {
  need_root
  [ "$(role)" = core ] || die "admin laptops are managed on the core"
  case ${1:-} in
    add)
      [ $# -eq 4 ] || die "usage: getarp-ctl admin add <name> <tunnel-ip> <public-key>"
      registry_add admin "$2" "$3" "$4" ""
      cmd_apply >/dev/null
      load_env core
      cat <<EOF
[getarp] admin $2 added. Put this in the laptop's WireGuard config
         (replace the private key with the one made on the laptop):

[Interface]
Address = $3/32
PrivateKey = <the laptop's private key>

[Peer]
PublicKey = $(cat "$WG_DIR/public.key")
Endpoint = ${PUBLIC_IP}:${WG_PORT:-51820}
AllowedIPs = 10.66.0.0/24
PersistentKeepalive = 25

Then add this line to the laptop's hosts file:
10.66.0.1  ${ADMIN_DOMAIN:-admin.getarp.internal}
EOF
      ;;
    remove)
      [ $# -eq 2 ] || die "usage: getarp-ctl admin remove <name>"
      registry_disable admin "$2"
      cmd_apply >/dev/null
      say "admin $2 removed"
      ;;
    *) die "usage: getarp-ctl admin add|remove ..." ;;
  esac
}

cmd_list() {
  [ "$(role)" = core ] || die "the registry is on the core"
  ensure_registry
  column -s, -t < "$PEERS"
}

cmd_info() {
  case $(role) in
    core)
      load_env core
      cat <<EOF
Core tunnel public key : $(cat "$WG_DIR/public.key")
Core tunnel endpoint   : ${PUBLIC_IP}:${WG_PORT:-51820}
Next free sensor addr  : $(next_free 11 250)
Next free admin addr   : $(next_free 2 10)

New sensor:  sudo ./install.sh sensor --core ${PUBLIC_IP} --core-key $(cat "$WG_DIR/public.key") --tunnel-ip $(next_free 11 250)
EOF
      ;;
    sensor)
      load_env sensor
      cat <<EOF
Sensor name            : ${NAME}
Sensor tunnel address  : ${TUNNEL_IP}
Sensor tunnel key      : $(cat "$WG_DIR/public.key")
Sensor public address  : ${PUBLIC_IP:-unknown}

Register it on the core:
  sudo getarp-ctl sensor add ${NAME} ${TUNNEL_IP} $(cat "$WG_DIR/public.key") ${PUBLIC_IP:-<public-ip>}
EOF
      ;;
  esac
}

next_free() { # lowest unused last octet in [lo, hi]
  ensure_registry
  local used n
  used=$(peers_rows | cut -d, -f3 | sed 's/^10\.66\.0\.//' | sort -n | tr '\n' ' ')
  for ((n = $1; n <= $2; n++)); do
    [[ " $used " == *" $n "* ]] || { echo "10.66.0.$n"; return; }
  done
  echo "none left"
}

age() { # seconds -> short text
  local s=$1
  if [ "$s" -lt 0 ]; then echo "never"
  elif [ "$s" -lt 120 ]; then echo "${s}s"
  elif [ "$s" -lt 7200 ]; then echo "$((s / 60))m"
  else echo "$((s / 3600))h"; fi
}

unit_line() {
  local u state
  for u in "$@"; do
    state=$(systemctl is-active "$u" 2>/dev/null || true)
    printf '  %-28s %s\n' "$u" "${state:-unknown}"
  done
}

cmd_status() {
  local now; now=$(date +%s)
  case $(role) in
    core)
      load_env core
      echo "Services"
      unit_line wg-quick@wg0 getarp-firewall "postgresql@${PG_MAJOR:-17}-main" redis-server crowdsec \
        crowdsec-firewall-bouncer getarp-ingest getarp@pipeline getarp@enrichment \
        getarp@analytics getarp@api caddy
      echo
      echo "Sensors"
      printf '  %-10s %-12s %-10s %-12s %s\n' NAME TUNNEL HANDSHAKE LAST-EVENT EVENTS
      declare -A hs=()
      local key ts
      while read -r key ts; do hs[$key]=$ts; done < <(wg show wg0 latest-handshakes 2>/dev/null || true)
      local kind name ip pub en last count
      while IFS=, read -r kind name ip key pub en; do
        [ "$kind" = sensor ] && [ "$en" = yes ] || continue
        ts=${hs[$key]:-0}
        read -r last count < <(python3 -I -c '
import json, sys
try:
    s = json.load(open(sys.argv[1]))["sensors"].get(sys.argv[2], {})
except Exception:
    s = {}
print(s.get("last_seen") or 0, s.get("accepted", 0))' "$LIB/ingest/status.json" "$name")
        printf '  %-10s %-12s %-10s %-12s %s\n' "$name" "$ip" \
          "$( [ "$ts" -gt 0 ] && age $((now - ts)) || echo never)" \
          "$( [ "$last" -gt 0 ] && age $((now - last)) || echo never)" "$count"
      done < <(peers_rows)
      echo
      echo "Disk"
      df -h / /var/lib/postgresql 2>/dev/null | awk 'NR==1 || !seen[$1]++' | sed 's/^/  /'
      ;;
    sensor)
      echo "Services"
      unit_line wg-quick@wg0 getarp-firewall getarp-cowrie getarp-decoys getarp-suricata getarp-shipper
      echo
      local ts; ts=$(wg show wg0 latest-handshakes 2>/dev/null | awk '{print $2; exit}')
      echo "Tunnel to the core: last handshake $( [ "${ts:-0}" -gt 0 ] && age $((now - ts)) || echo never) ago"
      ;;
  esac
}

cmd_backup() {
  need_root
  [ "$(role)" = core ] || die "backups run on the core"
  local dir=/var/backups/getarp stamp; stamp=$(date -u +%Y%m%dT%H%M%SZ)
  install -d -m 0700 "$dir"
  runuser -u postgres -- pg_dump -Fc getarp > "$dir/getarp-$stamp.dump"
  chmod 0600 "$dir/getarp-$stamp.dump"
  find "$dir" -name 'getarp-*.dump' -mtime +7 -delete
  say "backup written: $dir/getarp-$stamp.dump"
  load_env core
  if [ -n "${BACKUP_S3_URI:-}" ]; then
    python3 -I - "$dir/getarp-$stamp.dump" "$BACKUP_S3_URI" <<'PY'
import sys, boto3
path, uri = sys.argv[1], sys.argv[2].rstrip("/")
bucket, _, prefix = uri[len("s3://"):].partition("/")
key = (prefix + "/" if prefix else "") + path.rsplit("/", 1)[1]
boto3.client("s3").upload_file(path, bucket, key, ExtraArgs={"ServerSideEncryption": "AES256"})
print(f"[getarp] copied to s3://{bucket}/{key}")
PY
  fi
}

cmd_password() {
  need_root
  [ "$(role)" = core ] || die "dashboard logins live on the core"
  local user=${1:-}
  [[ "$user" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "usage: getarp-ctl password <username>"
  local pw pw2
  read -rsp "New password for $user: " pw; echo
  read -rsp "Same again: " pw2; echo
  [ "$pw" = "$pw2" ] || die "the two passwords differ; nothing changed"
  [ ${#pw} -ge 12 ] || die "use at least 12 characters"
  local hash
  hash=$(printf '%s' "$pw" | /opt/getarp/venv/bin/python -I -c \
    'import sys; from passlib.context import CryptContext; print(CryptContext(schemes=["bcrypt"]).hash(sys.stdin.read()))')
  (cd / && runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d getarp -v u="$user" -v h="$hash") <<'SQL'
INSERT INTO users (username, password_hash, role) VALUES (:'u', :'h', 'admin')
ON CONFLICT (username) DO UPDATE SET password_hash = EXCLUDED.password_hash;
SQL
  say "password set for $user"
}

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

case ${1:-} in
  apply) cmd_apply ;;
  sensor) shift; cmd_sensor "$@" ;;
  admin) shift; cmd_admin "$@" ;;
  list) cmd_list ;;
  info) cmd_info ;;
  status) cmd_status ;;
  backup) cmd_backup ;;
  password) shift; cmd_password "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command '$1' (try: getarp-ctl help)" ;;
esac
