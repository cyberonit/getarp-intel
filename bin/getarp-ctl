#!/usr/bin/env bash
# getarp-ctl: day-to-day operations for a getarp core or sensor.
#
# On the core:
#   getarp-ctl status                          services and sensors at a glance
#   getarp-ctl sensor add <name> <public-ip>   register a sensor; prints its key and install command
#   getarp-ctl sensor move <name> <public-ip>  the sensor's public address changed
#   getarp-ctl sensor remove <name>            revoke now; the name is never reused
#   getarp-ctl admin add <name> <ip[/bits]>    allow admin access (sign-in, IP detail) from there
#   getarp-ctl admin remove <name>
#   getarp-ctl list                            every registered sensor and admin address
#   getarp-ctl apply                           rebuild firewall, web server and allowlist from the registry
#   getarp-ctl backup                          database dump now (also runs nightly)
#   getarp-ctl password <username>             set a dashboard login's password (creates it if new)
#   getarp-ctl info                            what this core is and how to add things
#
# On a sensor:
#   getarp-ctl status | info | apply
# shellcheck disable=SC2015
set -euo pipefail

ETC=${GETARP_ETC:-/etc/getarp}
LIB=${GETARP_LIB:-/var/lib/getarp}
CADDYFILE=${GETARP_CADDYFILE:-/etc/caddy/Caddyfile}
PEERS="$ETC/peers.csv"
PEERS_HEADER="kind,name,secret,address,enabled"
NFT_FILE="$ETC/nftables.nft"
DRY_RUN=${GETARP_DRY_RUN:-0}   # 1 = render files only, touch no live service (tests)

die() { echo "getarp-ctl: $*" >&2; exit 1; }
say() { echo "[getarp] $*"; }
live() { [ "$DRY_RUN" != 1 ]; }

role() {
  [ -f "$ETC/role" ] || die "this machine is not set up yet (no $ETC/role); run install.sh first"
  cat "$ETC/role"
}

need_root() { live || return 0; [ "$(id -u)" = 0 ] || die "run as root (sudo)"; }

load_env() {
  # shellcheck disable=SC1090
  . "$ETC/$1.env"
}

# ---------------------------------------------------------------- validation
valid_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{1,30}$ ]]; }
valid_ipv4() {
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o; for o in "${BASH_REMATCH[@]:1}"; do [ "$o" -le 255 ] || return 1; done
}
valid_cidr() {
  local ip=${1%/*} bits=32
  [[ "$1" == */* ]] && bits=${1#*/}
  valid_ipv4 "$ip" && [[ "$bits" =~ ^[0-9]{1,2}$ ]] && [ "$bits" -ge 8 ] && [ "$bits" -le 32 ]
}
sha256() { printf '%s' "$1" | sha256sum | cut -d' ' -f1; }

# ---------------------------------------------------------------- registry
ensure_registry() { [ -f "$PEERS" ] || { echo "$PEERS_HEADER" > "$PEERS"; chmod 0644 "$PEERS"; }; }
peers_rows() { tail -n +2 "$PEERS"; }   # kind,name,secret,address,enabled
enabled() { peers_rows | awk -F, -v k="$1" '$1==k && $5=="yes" {print $4}'; }   # addresses
join_list() { paste -sd, - | sed 's/,/, /g'; }

registry_add() { # kind name secret-hash address
  ensure_registry
  if peers_rows | awk -F, -v n="$2" '$2==n{f=1} END{exit !f}'; then
    die "the name $2 is (or was) registered; pick a new one"
  fi
  echo "$1,$2,$3,$4,yes" >> "$PEERS"
}

registry_set() { # kind name column value   (column: 4 = address, 5 = enabled)
  ensure_registry
  peers_rows | awk -F, -v k="$1" -v n="$2" '$1==k && $2==n && $5=="yes"{f=1} END{exit !f}' \
    || die "no active $1 called $2"
  local tmp; tmp=$(mktemp "$ETC/peers.XXXXXX")
  awk -F, -v OFS=, -v k="$1" -v n="$2" -v c="$3" -v v="$4" 'NR>1 && $1==k && $2==n {$c=v} {print}' \
    "$PEERS" > "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$PEERS"
}

# ---------------------------------------------------------------- core: render
render_nft_core() {
  load_env core
  local tmp; tmp=$(mktemp "$ETC/nftables.XXXXXX")
  cat > "$tmp" <<EOF
#!/usr/sbin/nft -f
# getarp core firewall. Written by getarp-ctl. Lives in its own table: never
# touches CrowdSec's tables or anything else.

table inet getarp
delete table inet getarp

table inet getarp {
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept
		meta l4proto { icmp, ipv6-icmp } accept

		# the dashboard, and the sensors' log delivery (both HTTPS, through Caddy)
		tcp dport { 80, 443 } accept
		# admin SSH
		tcp dport { ${SSH_PORTS} } accept

		limit rate 10/minute log prefix "getarp-in-drop " level info
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
EOF
  chmod 0600 "$tmp"
  if live; then
    nft -c -f "$tmp" || { rm -f "$tmp"; die "new firewall rules failed the syntax check; nothing changed"; }
  fi
  mv "$tmp" "$NFT_FILE"
  if live; then nft -f "$NFT_FILE"; fi
}

render_caddy() {
  load_env core
  local sensors admins
  sensors=$(enabled sensor | tr '\n' ' ' | sed 's/ *$//')
  admins=$(enabled admin | tr '\n' ' ' | sed 's/ *$//')
  local tmp; tmp=$(mktemp "$(dirname "$CADDYFILE")/.Caddyfile.XXXXXX")
  {
    cat <<EOF
# getarp. Written by getarp-ctl from $PEERS; run "getarp-ctl apply" after changes.
{
	email ${EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'"
		-Server
	}
}

${DOMAIN} {
	bind ${BIND_IP}
	encode gzip
	import security_headers
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}

EOF
    if [ -n "$sensors" ]; then
      cat <<EOF
	# log delivery: registered sensors only (each also needs its own key)
	@sensors {
		path /ingest
		remote_ip ${sensors}
	}
	handle @sensors {
		request_body {
			max_size 8MB
		}
		reverse_proxy 127.0.0.1:6000
	}
EOF
    fi
    if [ -n "$admins" ]; then
      cat <<EOF
	# admin access (sign-in, per-IP detail): registered admin addresses only
	@admin_api {
		path /api/*
		remote_ip ${admins}
	}
	handle @admin_api {
		reverse_proxy 127.0.0.1:8000
	}
EOF
    fi
    cat <<EOF
	# everyone else: the read-only public routes
	@public_api path /api/status /api/ips /api/top-countries /api/top-as /api/findings /api/behavior /api/ws /api/health
	handle @public_api {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/* {
		respond 404
	}
	handle /ingest {
		respond 404
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /var/www/getarp
		file_server
	}
	handle {
		root * /var/www/getarp
		try_files {path} /index.html
		file_server
	}
}
EOF
  } > "$tmp"
  chmod 0644 "$tmp"
  if live; then
    runuser -u caddy -- env HOME=/var/lib/caddy caddy validate --adapter caddyfile --config "$tmp" \
      >/dev/null 2>&1 || { rm -f "$tmp"; die "the new web server config did not validate; nothing changed"; }
  fi
  mv "$tmp" "$CADDYFILE"
  if live && systemctl is-active --quiet caddy; then systemctl reload caddy; fi
}

render_crowdsec_allowlist() {
  load_env core
  local dir=${GETARP_CROWDSEC_DIR:-/etc/crowdsec}/parsers/s02-enrich
  [ -d "$dir" ] || { live && return 0; mkdir -p "$dir"; }
  local tmp; tmp=$(mktemp "$dir/.getarp-whitelist.XXXXXX")
  {
    echo "# Written by getarp-ctl. getarp's own and admin addresses are never banned."
    echo "name: getarp/whitelist"
    echo "description: getarp infrastructure and admins"
    echo "whitelist:"
    echo "  reason: getarp infrastructure"
    echo "  ip:"
    echo "    - \"127.0.0.1\""
    [ -n "${PUBLIC_IP:-}" ] && echo "    - \"$PUBLIC_IP\""
    [ -n "${BIND_IP:-}" ] && echo "    - \"$BIND_IP\""
    enabled sensor | awk 'NF{print "    - \"" $0 "\""}'
    if [ -n "$(enabled admin)" ]; then
      echo "  cidr:"
      enabled admin | awk 'NF{ c = ($0 ~ /\//) ? $0 : $0 "/32"; print "    - \"" c "\""}'
    fi
  } > "$tmp"
  chmod 0644 "$tmp"
  if cmp -s "$tmp" "$dir/getarp-whitelist.yaml"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$dir/getarp-whitelist.yaml"
    if live && systemctl is-active --quiet crowdsec; then systemctl reload crowdsec || systemctl restart crowdsec; fi
  fi
}

# ---------------------------------------------------------------- sensor: render
render_nft_sensor() {
  load_env sensor
  # Accounts allowed to reach the internet for updates, DNS and time. The decoy
  # accounts (cowrie, hpextra) and suricata are deliberately absent.
  local u users=()
  for u in root _apt systemd-resolve systemd-timesync _chrony; do
    getent passwd "$u" >/dev/null && users+=("\"$u\"")
  done
  local userset; userset=$(IFS=,; echo "${users[*]}"); userset=${userset//,/, }
  local admin_rule=""
  if [ -n "${ADMIN_CIDR:-}" ]; then
    admin_rule="iifname \"${PUBLIC_IFACE}\" ip saddr { ${ADMIN_CIDR//,/, } } tcp dport 2022 accept"
  fi
  local tmp; tmp=$(mktemp "$ETC/nftables.XXXXXX")
  cat > "$tmp" <<EOF
#!/usr/sbin/nft -f
# getarp sensor firewall. Written by getarp-ctl.
# Default deny both ways. The decoys answer attackers; only the shipper may
# send anything to the core; the decoy accounts cannot open any connection.

table inet getarp
delete table inet getarp

table inet getarp {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		# public decoy ports -> unprivileged decoy listeners
		iifname "${PUBLIC_IFACE}" tcp dport 22 redirect to :2222
		iifname "${PUBLIC_IFACE}" tcp dport 23 redirect to :2223
		iifname "${PUBLIC_IFACE}" tcp dport 80 redirect to :8080
		iifname "${PUBLIC_IFACE}" tcp dport 21 redirect to :2121
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept
		meta l4proto { icmp, ipv6-icmp } accept

		# decoys
		iifname "${PUBLIC_IFACE}" tcp dport { 2222, 2223, 8080, 8081, 2121, 3306, 6379 } accept

		# real SSH: admin addresses only
		${admin_rule}
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy drop;
		ct state established,related accept
		oifname "lo" accept

		# log delivery: only the shipper, only to the core, only HTTPS
		meta skuid "getarp-ship" ip daddr ${CORE_IP} tcp dport 443 accept
		meta skuid "getarp-ship" meta l4proto { tcp, udp } th dport 53 accept

		# updates, names and time for the system accounts only
		meta skuid { ${userset} } udp dport { 53, 123 } accept
		meta skuid { ${userset} } tcp dport { 53, 80, 443 } accept

		limit rate 10/minute log prefix "getarp-out-drop " level warn
	}
}
EOF
  chmod 0600 "$tmp"
  if live; then
    nft -c -f "$tmp" || { rm -f "$tmp"; die "new firewall rules failed the syntax check; nothing changed"; }
  fi
  mv "$tmp" "$NFT_FILE"
  if live; then nft -f "$NFT_FILE"; fi
}

# ---------------------------------------------------------------- commands
cmd_apply() {
  need_root
  case $(role) in
    core) ensure_registry; render_nft_core; render_caddy; render_crowdsec_allowlist ;;
    sensor) render_nft_sensor ;;
  esac
  say "applied"
}

cmd_sensor() {
  need_root
  [ "$(role)" = core ] || die "sensors are managed on the core"
  case ${1:-} in
    add)
      [ $# -eq 3 ] || die "usage: getarp-ctl sensor add <name> <public-ip>"
      valid_name "$2" || die "name: lowercase letters, digits and dashes, e.g. s01"
      valid_ipv4 "$3" || die "give the sensor's public IPv4 address"
      local key; key=$(openssl rand -hex 32)
      registry_add sensor "$2" "$(sha256 "$key")" "$3"
      cmd_apply >/dev/null
      load_env core
      cat <<EOF
[getarp] sensor $2 registered at $3.

  Its key (shown only now; the core keeps only a hash of it):
    $key

  On the sensor machine, from the getarp-intel folder:
    sudo ./install.sh sensor --core https://${DOMAIN} --key $key
EOF
      ;;
    move)
      [ $# -eq 3 ] || die "usage: getarp-ctl sensor move <name> <new-public-ip>"
      valid_ipv4 "$3" || die "give the sensor's new public IPv4 address"
      registry_set sensor "$2" 4 "$3"
      cmd_apply >/dev/null
      say "sensor $2 now delivers from $3"
      ;;
    remove)
      [ $# -eq 2 ] || die "usage: getarp-ctl sensor remove <name>"
      registry_set sensor "$2" 5 no
      cmd_apply >/dev/null
      say "sensor $2 revoked: its key and address no longer work. Collected data is kept."
      ;;
    *) die "usage: getarp-ctl sensor add|move|remove ..." ;;
  esac
}

cmd_admin() {
  need_root
  [ "$(role)" = core ] || die "admin addresses are managed on the core"
  case ${1:-} in
    add)
      [ $# -eq 3 ] || die "usage: getarp-ctl admin add <name> <ip or ip/bits>"
      valid_name "$2" || die "name: lowercase letters, digits and dashes, e.g. office"
      valid_cidr "$3" || die "give an IPv4 address or range, e.g. 203.0.113.7 or 203.0.113.0/24"
      registry_add admin "$2" "" "$3"
      cmd_apply >/dev/null
      say "admin access allowed from $3 ($2): sign in on the dashboard from there"
      ;;
    remove)
      [ $# -eq 2 ] || die "usage: getarp-ctl admin remove <name>"
      registry_set admin "$2" 5 no
      cmd_apply >/dev/null
      say "admin address $2 removed"
      ;;
    *) die "usage: getarp-ctl admin add|remove ..." ;;
  esac
}

cmd_list() {
  [ "$(role)" = core ] || die "the registry is on the core"
  ensure_registry
  { echo "KIND,NAME,ADDRESS,ACTIVE"; peers_rows | awk -F, -v OFS=, '{print $1, $2, $4, $5}'; } | column -s, -t
}

cmd_info() {
  case $(role) in
    core)
      load_env core
      cat <<EOF
Dashboard        : https://${DOMAIN}
Admin addresses  : $(enabled admin | join_list)
Sensors          : $(peers_rows | awk -F, '$1=="sensor" && $5=="yes"' | wc -l) active

Add a sensor     : sudo getarp-ctl sensor add <name> <sensor public ip>
Allow an admin   : sudo getarp-ctl admin add <name> <your public ip>
EOF
      ;;
    sensor)
      load_env sensor
      cat <<EOF
Core             : ${CORE_URL} (${CORE_IP})
This sensor      : ${PUBLIC_IP:-unknown} on ${PUBLIC_IFACE}
Admin SSH from   : ${ADMIN_CIDR:-nowhere}
EOF
      ;;
  esac
}

age() { # seconds -> short text
  local s=$1
  if [ "$s" -lt 120 ]; then echo "${s}s"
  elif [ "$s" -lt 7200 ]; then echo "$((s / 60))m"
  else echo "$((s / 3600))h"; fi
}

unit_line() {
  local u state
  for u in "$@"; do
    state=$(systemctl is-active "$u" 2>/dev/null || true)
    printf '  %-28s %s\n' "$u" "${state:-unknown}"
  done
}

cmd_status() {
  local now; now=$(date +%s)
  case $(role) in
    core)
      load_env core
      echo "Services"
      unit_line getarp-firewall "postgresql@${PG_MAJOR:-17}-main" crowdsec crowdsec-firewall-bouncer \
        getarp-ingest getarp@pipeline getarp@enrichment getarp@api caddy
      echo
      echo "Sensors"
      printf '  %-12s %-16s %-12s %s\n' NAME ADDRESS LAST-EVENT EVENTS
      local kind name addr en last count
      while IFS=, read -r kind name _ addr en; do
        [ "$kind" = sensor ] && [ "$en" = yes ] || continue
        read -r last count < <(python3 -I -c '
import json, sys
try:
    s = json.load(open(sys.argv[1]))["sensors"].get(sys.argv[2], {})
except Exception:
    s = {}
print(s.get("last_seen") or 0, s.get("accepted", 0))' "$LIB/ingest/status.json" "$name")
        printf '  %-12s %-16s %-12s %s\n' "$name" "$addr" \
          "$( [ "$last" -gt 0 ] && echo "$(age $((now - last))) ago" || echo never)" "$count"
      done < <(peers_rows)
      echo
      echo "Disk"
      df -h / /var/lib/postgresql 2>/dev/null | awk 'NR==1 || !seen[$1]++' | sed 's/^/  /'
      ;;
    sensor)
      echo "Services"
      unit_line getarp-firewall getarp-cowrie getarp-decoys getarp-suricata getarp-shipper
      echo
      echo "Delivery to the core (latest shipper message):"
      echo "  $(journalctl -u getarp-shipper -n 1 --no-pager -o cat 2>/dev/null || echo unknown)"
      ;;
  esac
}

cmd_backup() {
  need_root
  [ "$(role)" = core ] || die "backups run on the core"
  local dir=/var/backups/getarp stamp; stamp=$(date -u +%Y%m%dT%H%M%SZ)
  install -d -m 0700 "$dir"
  (cd / && runuser -u postgres -- pg_dump -Fc getarp) > "$dir/getarp-$stamp.dump"
  chmod 0600 "$dir/getarp-$stamp.dump"
  find "$dir" -name 'getarp-*.dump' -mtime +7 -delete
  say "backup written: $dir/getarp-$stamp.dump"
  load_env core
  if [ -n "${BACKUP_S3_URI:-}" ]; then
    python3 -I - "$dir/getarp-$stamp.dump" "$BACKUP_S3_URI" <<'PY'
import sys, boto3
path, uri = sys.argv[1], sys.argv[2].rstrip("/")
bucket, _, prefix = uri[len("s3://"):].partition("/")
key = (prefix + "/" if prefix else "") + path.rsplit("/", 1)[1]
boto3.client("s3").upload_file(path, bucket, key, ExtraArgs={"ServerSideEncryption": "AES256"})
print(f"[getarp] copied to s3://{bucket}/{key}")
PY
  fi
}

cmd_password() {
  need_root
  [ "$(role)" = core ] || die "dashboard logins live on the core"
  local user=${1:-}
  [[ "$user" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "usage: getarp-ctl password <username>"
  local pw pw2
  read -rsp "New password for $user: " pw; echo
  read -rsp "Same again: " pw2; echo
  [ "$pw" = "$pw2" ] || die "the two passwords differ; nothing changed"
  [ ${#pw} -ge 12 ] || die "use at least 12 characters"
  local hash
  hash=$(printf '%s' "$pw" | /opt/getarp/venv/bin/python -I -c \
    'import sys, bcrypt; print(bcrypt.hashpw(sys.stdin.read().encode(), bcrypt.gensalt()).decode())')
  (cd / && runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d getarp -v u="$user" -v h="$hash") <<'SQL'
INSERT INTO users (username, password_hash) VALUES (:'u', :'h')
ON CONFLICT (username) DO UPDATE SET password_hash = EXCLUDED.password_hash;
SQL
  say "password set for $user"
}

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

case ${1:-} in
  apply) cmd_apply ;;
  sensor) shift; cmd_sensor "$@" ;;
  admin) shift; cmd_admin "$@" ;;
  list) cmd_list ;;
  info) cmd_info ;;
  status) cmd_status ;;
  backup) cmd_backup ;;
  password) shift; cmd_password "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command '$1' (try: getarp-ctl help)" ;;
esac
