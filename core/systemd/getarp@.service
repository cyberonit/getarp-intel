# One unit for the three application services:
#   getarp@pipeline  getarp@enrichment  getarp@api
# Each runs as its own account (svc-<name>) with its own database login.
[Unit]
StartLimitIntervalSec=0
Description=getarp %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=svc-%i
Group=svc-%i
EnvironmentFile=/etc/getarp/app.env
EnvironmentFile=/etc/getarp/svc/%i.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/getarp/app
WorkingDirectory=/opt/getarp/app
# GETARP_ARGS comes from /etc/getarp/svc/%i.env
ExecStart=/opt/getarp/venv/bin/python $GETARP_ARGS
Restart=always
RestartSec=5
MemoryMax=768M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
