[Unit]
StartLimitIntervalSec=0
Description=getarp ingest (sensor logs, delivered over HTTPS through Caddy)
After=network.target

[Service]
User=getarp-ingest
Group=getarp-logs
UMask=0027
EnvironmentFile=-/etc/getarp/ingest.env
ExecStart=/usr/bin/python3 -I /opt/getarp/core/getarp-ingest.py
Restart=always
RestartSec=3
ReadWritePaths=/var/lib/getarp/logs /var/lib/getarp/ingest
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
